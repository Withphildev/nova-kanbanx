PORT=3001
# Optional: absolute path to sqlite db file. Defaults to server/kanban.db.
KANBAN_DB_PATH=
# Optional: receives POST JSON events for card lifecycle actions.
# Events: card.created, card.updated, card.moved, card.deleted
OPENCLAW_WORKFLOW_HOOK_URL=

# Optional durable reminder delivery. Inactive until a hook URL is set.
KANBAN_REMINDER_HOOK_URL=
KANBAN_REMINDER_HOOK_TOKEN=
KANBAN_REMINDER_POLL_MS=60000
KANBAN_REMINDER_TIMEOUT_MS=5000

# Optional bundled gentle nudges. Falls back to KANBAN_REMINDER_HOOK_URL when unset.
KANBAN_NUDGE_HOOK_URL=
KANBAN_NUDGE_HOOK_TOKEN=
KANBAN_NUDGE_POLL_MS=900000
KANBAN_NUDGE_TIMEZONE=America/Los_Angeles
KANBAN_NUDGE_QUIET_START_HOUR=21
KANBAN_NUDGE_QUIET_END_HOUR=8

# Optional LoopX control-plane adapter. LOOPX_GOAL_ID enables the integration.
LOOPX_BIN=loopx
LOOPX_GOAL_ID=
LOOPX_REGISTRY=
LOOPX_PROJECT=
LOOPX_AGENT_ID=
LOOPX_TIMEOUT_MS=5000
